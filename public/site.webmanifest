{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Trisukses Bangun Karya",
  "short_name": "Trisukses Bangun Karya",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#F53838",
  "description": "Trisukses Bangun Karya Penyedia jasa bangun pembangunan renovasi bangunan murah Jawa Timur.",
  "icons": [
    {
      "src": "/favicon/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/favicon/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/favicon.png",
      "sizes": "100x100",
      "type": "image/png"
    }
  ]
}
